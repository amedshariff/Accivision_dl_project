# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo

# VS Code & IDE
.vscode/
.idea/

# Environment/secrets
.env

# Generated runs & logs
runs/
logs/

# Generated outputs (preserve output folder structure via .gitkeep)
outputs/*
!outputs/detections/
!outputs/detections/.gitkeep
!outputs/tracking/
!outputs/tracking/.gitkeep

# Exclude generated video files outside data/raw
*.avi
*.mov
*.mkv
outputs/**/*.mp4
